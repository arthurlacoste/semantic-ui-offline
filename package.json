{
  "name": "semantic-ui-offline",
  "version": "2.5.1",
  "title": "Semantic UI",
  "description": "CSS Only distribution of Semantic UI, with fonts.",
  "homepage": "https://arthurlacoste.com",
  "author": "Arthur Lacoste <arthak@gmail.com>",
  "license": "MIT",
  "main": "semantic.js",
  "repository": {
    "type": "git",
